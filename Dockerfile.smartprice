FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build
ENV NODE_ENV=production
ENV SMARTPRICE_DB=/app/data/smartprice.sqlite
RUN mkdir -p /app/data && chown -R node:node /app
USER node
EXPOSE 3005
CMD ["npm", "start"]
