# Server-side AI API configuration (copy to .env.local and fill in your key)
# Supports any OpenAI-compatible API (e.g. alem.ai, OpenAI, Groq, OpenRouter, DeepSeek) or Gemini
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://llm.alem.ai/v1
AI_MODEL=qwen3-8
AI_API_KEY=your-api-key-here
# Optional multimodal vision model if different from AI_MODEL (e.g. gpt-4o-mini or gemini-2.5-flash)
AI_VISION_MODEL=
# Optional Gemini native key if using AI_PROVIDER=gemini
GEMINI_API_KEY=

